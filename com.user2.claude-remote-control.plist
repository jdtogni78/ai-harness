<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user2.claude-remote-control</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>-m</string>
        <string>remote_control</string>
        <string>supervisor</string>
    </array>

    <!-- This machine: the MacBook (nickname "note"). config.py defaults are
         HOME-derived (Path.home()/dev, ~/.local/bin/claude, ~/dev/ai-harness/logs,
         ~/.ai-harness/active-dirs.txt), so the supervisor runs without any
         non-nick REMOTE_CONTROL_* overrides on a stock user2 account.
         REMOTE_CONTROL_HOST below is set explicitly so `installer.seed_host_file`
         captures it into `~/.ai-harness/host` on first install (#32 Phase B);
         the MacBook's hostname doesn't auto-derive to "note", so the explicit
         set is also load-bearing at run time until the seed lands. After
         install the file is authoritative -- rename this host by editing the
         file, not the plist. /usr/bin/python3 is the always-present system
         Python; the package is stdlib-only so no venv/site-packages is
         required. PYTHONPATH stays literal because launchd doesn't expand $HOME. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/user2/dev/ai-harness</string>
        <key>REMOTE_CONTROL_HOST</key>
        <string>note</string>
    </dict>

    <!-- Start at login and keep the supervisor itself alive: if it crashes,
         launchd relaunches it (throttled) and it re-adopts the servers. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- NO AbandonProcessGroup and NO StartInterval, on purpose: keeping the
         servers in the supervisor's process group lets launchd SIGTERM the
         whole tree at logout/reboot, and the supervisor's TERM trap forwards it
         so each server can deregister from the cloud (see README). -->

    <key>StandardOutPath</key>
    <string>/Users/user2/dev/ai-harness/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/user2/dev/ai-harness/logs/launchd.err.log</string>
</dict>
</plist>
