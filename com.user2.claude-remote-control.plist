<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user2.claude-remote-control</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>-m</string>
        <string>remote_control</string>
        <string>supervisor</string>
    </array>

    <!-- This machine: the MacBook. config.py defaults are HOME-derived
         (Path.home()/dev, ~/.local/bin/claude, ~/dev/ai-harness/logs,
         ~/.ai-harness/active-dirs.txt), so the supervisor runs without any
         REMOTE_CONTROL_* overrides on a stock user2 account. Set
         REMOTE_CONTROL_HOST below to give this host its personal nickname
         (matched by @<nick> entries in active-dirs.txt); otherwise the
         nickname auto-derives from the hostname (the first dotted label
         lowercased). /usr/bin/python3 is the always-present system Python;
         the package is stdlib-only so no venv/site-packages is required.
         PYTHONPATH stays literal because launchd doesn't expand $HOME. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/user2/dev/ai-harness</string>
    </dict>

    <!-- Start at login and keep the supervisor itself alive: if it crashes,
         launchd relaunches it (throttled) and it re-adopts the servers. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- NO AbandonProcessGroup and NO StartInterval, on purpose: keeping the
         servers in the supervisor's process group lets launchd SIGTERM the
         whole tree at logout/reboot, and the supervisor's TERM trap forwards it
         so each server can deregister from the cloud (see README). -->

    <key>StandardOutPath</key>
    <string>/Users/user2/dev/ai-harness/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/user2/dev/ai-harness/logs/launchd.err.log</string>
</dict>
</plist>
