<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dtogni.claude-bridge-revive</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/dev/ai-harness/skills/revive-bridges/scripts/auto_revive.sh --max 8</string>
  </array>

  <!-- Every 5 minutes. launchd also fires this shortly after wake if the
       interval elapsed while asleep, which is exactly the laptop case. -->
  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/claude-bridge-revive.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/claude-bridge-revive.err</string>

  <key>ProcessType</key>
  <string>Background</string>

  <!-- Do not wake the machine just to run this. -->
  <key>LaunchOnlyOnce</key>
  <false/>
</dict>
</plist>
