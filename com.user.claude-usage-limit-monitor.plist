<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.claude-usage-limit-monitor</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>-m</string>
        <string>remote_control</string>
        <string>usage-monitor</string>
    </array>

    <!-- v2 monitor: USAGE_LIMIT_DRY_RUN 0 = live (POST resume), 1 = dry-run
         (detect + log only). PYTHONPATH puts the repo's remote_control package
         on the path for `python3 -m` (launchd's bare env / cwd won't find it). -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>USAGE_LIMIT_DRY_RUN</key>
        <string>0</string>
        <key>PYTHONPATH</key>
        <string>/Users/user/dev/ai-harness</string>
    </dict>

    <!-- Start at login, KeepAlive: a separate daemon from the remote-control
         supervisor on purpose. The supervisor must NOT be blocked on resuming
         rate-limited sessions, and this monitor must not be implicated in
         supervisor crashes/restarts. Same clean-shutdown shape: no
         AbandonProcessGroup, SIGTERM-trap inside the script lets launchd
         deliver TERM at logout/reboot so the state file is left consistent. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/user/dev/ai-harness/logs/usage-limit-monitor.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/user/dev/ai-harness/logs/usage-limit-monitor.err.log</string>
</dict>
</plist>
