#!/usr/bin/env bash
# Convenience wrapper: runs `python -m narrate` from narrate/.venv.
# Auto-bootstraps the venv on first use.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$HERE/.venv"

if [ ! -x "$VENV/bin/python" ]; then
  "$HERE/install.sh" >&2
fi

cd "$(dirname "$HERE")"   # so `python -m narrate` resolves the package
exec "$VENV/bin/python" -m narrate "$@"
