# Copy to .env and fill in. NEVER commit .env.
# The Claude API call is the ONLY thing that leaves this machine.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- optional overrides (sane defaults in voice_local/config.py) ---
# VL_MODEL=claude-opus-4-8
# VL_WHISPER_BIN=whisper-cli
# VL_WHISPER_MODEL=./models/ggml-base.en.bin
# VL_TTS_ENGINE=piper            # or: say  (macOS fallback, also fully local)
# VL_PIPER_BIN=piper
# VL_PIPER_VOICE=./models/en_US-lessac-medium.onnx
# VL_SAY_VOICE=Samantha
# VL_VAD_SILENCE_MS=800          # trailing silence that ends an utterance
# VL_VAD_RMS=0.012               # mic energy threshold for speech
