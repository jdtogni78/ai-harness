# voice-realtime (Approach B) — copy to .env and fill in. NEVER commit real keys.

# --- Required for the LIVE path (python main.py live) ---
# OpenAI Realtime API key (speech-to-speech, the "GPT brain").
OPENAI_API_KEY=sk-...

# --- Required for the Claude-as-tool reasoning handoff ---
# Without this, the tool falls back to a deterministic mock summarizer (fine for
# dry-run / inspection, but not the real reasoning-quality test).
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional tuning ---
# Realtime model + voice.
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=cedar

# Claude model used inside the tool.
CLAUDE_MODEL=claude-opus-4-8

# Reasoning routing (the tradeoff A/B switch):
#   claude -> Claude summarizes the StatusReport (GPT-brain + Claude-as-tool)   [default]
#   raw    -> return raw JSON, let the GPT brain reason unaided (shows its ceiling)
CLAUDE_ROUTING=claude
