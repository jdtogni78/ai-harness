# Copy to `.env` and fill in what you have. EVERYTHING here is optional —
# with none of it set the loop still dry-runs (local Whisper + macOS `say` +
# a keyless canned brain). Never commit a real .env.

# --- Brain (required for LIVE mode; optional for --dry-run) ---
# Without this, live mode refuses to start and --dry-run uses the canned brain.
ANTHROPIC_API_KEY=

# Claude model. Defaults to claude-opus-4-8. For lower voice latency you may
# prefer a faster model, e.g. claude-haiku-4-5.
# CLAUDE_MODEL=claude-opus-4-8

# --- STT (optional; falls back to local Whisper if unset) ---
DEEPGRAM_API_KEY=

# --- TTS (optional; falls back to macOS `say` if both unset) ---
# Cartesia takes precedence over ElevenLabs if both are set.
CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=71a7ad14-091c-4e8e-a314-022ece01c121
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# --- macOS `say` fallback voice (optional) ---
# SAY_VOICE=Samantha
